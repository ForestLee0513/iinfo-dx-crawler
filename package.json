{
  "name": "iidx-difficulty-crawler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "beatmania IIDX (e-amusement) difficulty score crawler — bookmarklet loader + Vite/TS-built logic",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/make-bookmarklet.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bookmarklet": "node scripts/make-bookmarklet.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.0",
    "jsdom": "^24.1.0",
    "terser": "^5.31.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
